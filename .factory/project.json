{
  "$schema": "./project.schema.json",
  "factoryVersion": 2,
  "project": "dun",
  "tier": "greenfield",
  "language": {
    "workflow": "zh-CN",
    "productPrimary": "zh-CN",
    "productSecondary": "en",
    "code": "en"
  },
  "humanPolicy": {
    "merge": "always",
    "gateChannel": "github-pr",
    "specDecision": "draft-ready",
    "productAcceptance": "merge",
    "existingTestChange": "github-spec-ready",
    "newDependency": "always",
    "outsidePattern": "always"
  },
  "maturity": {
    "levels": ["bootstrap", "supervised", "trusted", "autonomous"],
    "autonomousEnabled": false
  },
  "automation": {
    "autoMerge": false,
    "autoDeploy": false
  },
  "evidence": {
    "liveState": "github",
    "checks": "github-checks",
    "requirementDecision": "docs/requirements",
    "finalDelivery": "docs/requirements-and-github-comment"
  }
}

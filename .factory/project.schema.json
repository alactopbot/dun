{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DUN Factory project policy",
  "type": "object",
  "required": ["factoryVersion", "project", "tier", "language", "humanPolicy", "maturity", "automation", "evidence"],
  "properties": {
    "factoryVersion": { "const": 2 },
    "project": { "type": "string", "minLength": 1 },
    "tier": { "enum": ["revival", "greenfield", "oss", "client-production"] },
    "language": {
      "type": "object",
      "required": ["workflow", "productPrimary", "productSecondary", "code"]
    },
    "humanPolicy": {
      "type": "object",
      "required": ["merge", "gateChannel", "specDecision", "productAcceptance", "existingTestChange", "newDependency", "outsidePattern"],
      "properties": {
        "merge": { "const": "always" },
        "gateChannel": { "const": "github-pr" },
        "specDecision": { "const": "github-review" },
        "productAcceptance": { "const": "merge" },
        "existingTestChange": { "const": "github-spec-review" },
        "newDependency": { "const": "always" },
        "outsidePattern": { "const": "always" }
      },
      "additionalProperties": false
    },
    "maturity": {
      "type": "object",
      "required": ["levels", "autonomousEnabled"]
    },
    "automation": {
      "type": "object",
      "required": ["autoMerge", "autoDeploy"]
    },
    "evidence": { "type": "object" }
  },
  "additionalProperties": false
}
